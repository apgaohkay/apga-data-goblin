function appendByHeader(sheet, rowObj) {
  var headers = sheet.getRange(3, 1, 1, sheet.getLastColumn()).getValues()[0];
  var newRow = [];
  for (var i = 0; i < headers.length; i++) {
    var h = String(headers[i]).trim();
    if (rowObj.hasOwnProperty(h)) {
      newRow.push(rowObj[h]);
    } else {
      newRow.push('');
    }
  }
  sheet.appendRow(newRow);
}

function logRaw(ss, data) {
  var sheet = ss.getSheetByName('Raw Submissions');
  if (!sheet) {
    sheet = ss.insertSheet('Raw Submissions');
    sheet.appendRow(['Timestamp', 'Action', 'Raw JSON']);
    sheet.getRange('A1:C1').setFontWeight('bold');
  }
  sheet.appendRow([
    new Date().toISOString(),
    data.action || '',
    JSON.stringify(data)
  ]);
}

function bumpVisitCount(ss, participantId) {
  var sheet = ss.getSheetByName('Registry');
  var headers = sheet.getRange(3, 1, 1, sheet.getLastColumn()).getValues()[0];
  var idCol = -1;
  var vcCol = -1;
  for (var i = 0; i < headers.length; i++) {
    var h = String(headers[i]).replace('#','').trim();
    if (h === 'Participant ID') idCol = i;
    if (String(headers[i]).trim() === 'Visit Count') vcCol = i;
  }
  if (idCol === -1 || vcCol === -1) return;
  var lastRow = sheet.getLastRow();
  if (lastRow < 4) return;
  var vals = sheet.getRange(4, idCol + 1, lastRow - 3, 1).getValues();
  for (var i = 0; i < vals.length; i++) {
    if (String(vals[i][0]) === String(participantId)) {
      var cell = sheet.getRange(i + 4, vcCol + 1);
      cell.setValue((Number(cell.getValue()) || 0) + 1);
      break;
    }
  }
}

function num(v) {
  var n = Number(v);
  return isNaN(n) ? 0 : n;
}

function ok(obj) {
  return ContentService
    .createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}


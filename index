<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Access Point SSP</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#FAF7F2;color:#2D2926;padding:0 0 60px}
.top-bar{background:#B5451B;padding:14px 16px;position:sticky;top:0;z-index:100}
.top-bar h1{color:#fff;font-size:16px;font-weight:600;letter-spacing:0.02em}
.top-bar p{color:rgba(255,255,255,0.75);font-size:12px;margin-top:2px}
.nav{display:flex;background:#2D2926;position:sticky;top:56px;z-index:99;flex-wrap:wrap}
.nav-btn{flex:1;padding:12px 4px;border:none;background:transparent;color:rgba(255,255,255,0.6);font-size:12px;cursor:pointer;font-family:Arial,sans-serif;border-bottom:3px solid transparent;min-width:70px}
.nav-btn.active{color:#fff;border-bottom-color:#B5451B}
.screen{display:none;padding:12px 12px 0}
.screen.active{display:block}
.card{background:#fff;border:1px solid #E8E0D5;border-radius:10px;padding:14px;margin-bottom:10px}
.label{font-size:11px;font-weight:700;color:#6B5B4E;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:8px}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{padding:7px 13px;border:1px solid #C4B8A8;border-radius:20px;font-size:13px;cursor:pointer;background:transparent;color:#2D2926;font-family:Arial,sans-serif;-webkit-tap-highlight-color:transparent}
.chip.on{background:#B5451B;color:#fff;border-color:#B5451B}
.chip.sage.on{background:#4A6741;color:#fff;border-color:#4A6741}
.chip.teal.on{background:#1B6B6B;color:#fff;border-color:#1B6B6B}
.chip.danger.on{background:#8B1A1A;color:#fff;border-color:#8B1A1A}
.field{margin-bottom:10px}
.field label{font-size:12px;color:#6B5B4E;display:block;margin-bottom:4px}
.field input,.field select,.field textarea{width:100%;padding:9px 11px;border:1px solid #C4B8A8;border-radius:8px;font-size:14px;font-family:Arial,sans-serif;background:#fff;color:#2D2926;-webkit-appearance:none}
.field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:#B5451B}
.field textarea{min-height:70px;resize:vertical}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
.btn{width:100%;padding:13px;border:none;border-radius:8px;font-size:15px;font-weight:600;cursor:pointer;margin-top:8px;font-family:Arial,sans-serif;-webkit-tap-highlight-color:transparent}
.btn-rust{background:#B5451B;color:#fff}
.btn-sage{background:#4A6741;color:#fff}
.btn-teal{background:#1B6B6B;color:#fff}
.btn-rust:disabled,.btn-sage:disabled,.btn-teal:disabled{opacity:0.5}
.btn-outline{background:transparent;color:#B5451B;border:1px solid #B5451B;margin-top:6px}
.btn-outline-teal{background:transparent;color:#1B6B6B;border:1px solid #1B6B6B;margin-top:6px}
.success-box{background:#EAF3DE;border-radius:10px;padding:16px;text-align:center;margin-bottom:10px}
.success-box h3{color:#3B6D11;font-size:16px;margin-bottom:4px}
.success-box p{color:#3B6D11;font-size:13px;opacity:0.85}
.id-box{background:#E8E0D5;border-radius:10px;padding:20px;text-align:center;margin-bottom:10px}
.id-num{font-size:56px;font-weight:700;color:#B5451B;letter-spacing:0.1em}
.id-sub{font-size:12px;color:#6B5B4E;margin-top:6px}
.err{color:#8B1A1A;font-size:12px;margin-top:6px;display:none;padding:8px;background:#F5DCDC;border-radius:6px}
.reversal-wrap{background:#F5DCDC;border-radius:8px;padding:12px;margin-top:8px}
.toggle-row{display:flex;align-items:center;justify-content:space-between}
.toggle-row span{font-size:13px;font-weight:600}
.toggle-row input[type=checkbox]{width:20px;height:20px;cursor:pointer}
.hidden{display:none}
.section-hdr{background:#2D2926;color:#fff;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;padding:8px 12px;border-radius:6px;margin-bottom:8px}
.section-hdr.teal-hdr{background:#1B6B6B}
.spinner{display:inline-block;width:16px;height:16px;border:2px solid rgba(255,255,255,0.4);border-top-color:#fff;border-radius:50%;animation:spin 0.7s linear infinite;vertical-align:middle;margin-right:6px}
@keyframes spin{to{transform:rotate(360deg)}}
.attendee-row{background:#f0f7f7;border:1px solid #c4d8d8;border-radius:8px;padding:12px;margin-bottom:8px}
.attendee-row .row-num{font-size:11px;font-weight:700;color:#1B6B6B;margin-bottom:6px}
.attendee-count{text-align:center;font-size:14px;color:#6B5B4E;padding:8px;background:#E8E0D5;border-radius:8px;margin-bottom:10px}
</style>
</head>
<body>

<div class="top-bar">
<h1>Access Point of Georgia</h1>
<p>Syringe Services &amp; Harm Reduction Data System</p>
</div>

<div class="nav">
<button class="nav-btn active" onclick="showScreen('intake')">New Intake</button>
<button class="nav-btn" onclick="showScreen('lookup')">Lookup ID</button>
<button class="nav-btn" onclick="showScreen('visit')">Visit Log</button>
<button class="nav-btn" onclick="showScreen('events')">Events</button>
</div>

<!-- ════════════════ INTAKE SCREEN ════════════════ -->
<div id="screen-intake" class="screen active">
<div id="intake-form">
<div class="card">
<div class="label">Participant Type</div>
<div class="chips" data-group="ptype" data-mode="single">
<button class="chip" data-val="SSP">SSP</button>
<button class="chip" data-val="OEND">OEND</button>
<button class="chip" data-val="Community">Community</button>
<button class="chip" data-val="Secondary Distro">Sec Distro</button>
<button class="chip" data-val="Staff/Vol">Staff/Vol</button>
</div>
</div>
<div class="card">
<div class="label">Demographics</div>
<div class="row2">
<div class="field"><label>Initials</label><input id="i-initials" maxlength="4" autocapitalize="characters" placeholder="AB"></div>
<div class="field"><label>Birth Year</label><input id="i-year" type="number" inputmode="numeric" placeholder="1990"></div>
</div>
<div class="field"><label>Gender Identity</label></div>
<div class="chips" data-group="gender" data-mode="single">
<button class="chip">Woman</button><button class="chip">Man</button><button class="chip">Non-binary</button><button class="chip">Transgender</button><button class="chip">Other</button>
</div>
<div class="field" style="margin-top:6px"><input id="i-gender-other" placeholder="If other, specify"></div>
<div class="field"><label>Race / Ethnicity (select all)</label></div>
<div class="chips" data-group="race" data-mode="multi">
<button class="chip">White</button><button class="chip">Black</button><button class="chip">Hispanic/Latino</button><button class="chip">Native American</button><button class="chip">Asian</button><button class="chip">Pacific Islander</button><button class="chip">Multiracial</button><button class="chip">Other</button>
</div>
</div>
<div class="card">
<div class="label">Location</div>
<div class="row2">
<div class="field"><label>ZIP</label><input id="i-zip" inputmode="numeric" maxlength="5" placeholder="30601"></div>
<div class="field"><label>County</label>
<select id="i-county"><option value="">Select</option><option>Clarke</option><option>Oconee</option><option>Jackson</option><option>Madison</option><option>Barrow</option><option>Oglethorpe</option><option>Elbert</option><option>Hart</option><option>Franklin</option><option>Stephens</option><option>Habersham</option><option>Rabun</option><option>Other</option></select>
</div>
</div>
<div class="field"><label>Housing Status</label></div>
<div class="chips" data-group="housing" data-mode="single">
<button class="chip">Stably housed</button><button class="chip">Unstably housed</button><button class="chip">Unhoused</button><button class="chip">Shelter</button><button class="chip">Unknown</button>
</div>
</div>
<button class="btn btn-rust" onclick="submitIntake(this)">Generate anonymous ID</button>
<div id="intake-err" class="err">Initials, birth year, and gender are required.</div>
</div>
<div id="intake-result" class="hidden">
<div class="success-box"><h3>Participant Registered</h3><p>Anonymous ID assigned</p></div>
<div class="id-box"><div id="result-id" class="id-num"></div><div class="id-sub">Write this on their card</div></div>
<button class="btn btn-sage" onclick="goVisit()">Log visit for this ID →</button>
<button class="btn btn-outline" onclick="resetIntake()">Register another</button>
</div>
</div>

<!-- ════════════════ LOOKUP SCREEN ════════════════ -->
<div id="screen-lookup" class="screen">
<div class="card">
<div class="label">Find Participant ID</div>
<div class="row2">
<div class="field"><label>Initials</label><input id="l-initials" maxlength="4" autocapitalize="characters"></div>
<div class="field"><label>Birth Year</label><input id="l-year" type="number" inputmode="numeric"></div>
</div>
<button class="btn btn-rust" onclick="lookupId()">Search</button>
</div>
<div id="lookup-result" class="hidden">
<div class="id-box"><div id="lookup-id" class="id-num"></div></div>
<button class="btn btn-sage" onclick="goVisitFromLookup()">Log visit →</button>
</div>
<div id="lookup-none" class="hidden">
<div class="card" style="text-align:center;color:#8B1A1A">No match found. Check spelling or register as new.</div>
</div>
</div>

<!-- ════════════════ VISIT LOG SCREEN ════════════════ -->
<div id="screen-visit" class="screen">
<div class="card">
<div class="label">Participant</div>
<div class="row2">
<div class="field"><label>ID #</label><input id="v-id" inputmode="numeric" placeholder="1001"></div>
<div class="field"><label>Date</label><input id="v-date" type="date"></div>
</div>
</div>

<div class="card">
<div class="label">Worker</div>
<div class="chips" data-group="worker" data-mode="single">
<button class="chip">OK</button><button class="chip">RK</button><button class="chip">Other</button>
</div>
<div class="field" style="margin-top:6px"><input id="v-worker-other" class="hidden" placeholder="Worker initials" autocapitalize="characters"></div>
</div>

<div class="card">
<div class="label">Visit Details</div>
<div class="chips" data-group="nr" data-mode="single">
<button class="chip">New</button><button class="chip">Returning</button>
</div>
<div class="field" style="margin-top:8px"><label>Location</label></div>
<div class="chips" data-group="loc" data-mode="single">
<button class="chip">Office</button><button class="chip">Mobile</button><button class="chip">Paradise</button><button class="chip">Other</button>
</div>
<div class="field" style="margin-top:6px"><input id="v-loc-other" class="hidden" placeholder="Location name"></div>
<div class="field" style="margin-top:8px"><label>Housing Status</label></div>
<div class="chips" data-group="v-housing" data-mode="single">
<button class="chip">Stably housed</button><button class="chip">Unstably housed</button><button class="chip">Unhoused</button><button class="chip">Shelter</button><button class="chip">Unknown</button>
</div>
</div>

<div class="card">
<div class="section-hdr">Substance Use</div>
<div class="label">Primary Substance (select all)</div>
<div class="chips" data-group="subst" data-mode="multi">
<button class="chip">Heroin/fentanyl</button><button class="chip">Methamphetamine</button><button class="chip">Cocaine/crack</button><button class="chip">Rx opioids</button><button class="chip">Cannabis</button><button class="chip">Benzodiazepines</button><button class="chip">Alcohol</button><button class="chip">Other / unknown</button><button class="chip">None/not disclosed</button>
</div>
<div class="field" style="margin-top:8px"><label>Route of Admin</label></div>
<div class="chips" data-group="route" data-mode="multi">
<button class="chip">Injection</button><button class="chip">Smoking</button><button class="chip">Snorting</button><button class="chip">Oral</button><button class="chip">Other</button>
</div>
</div>

<div class="card">
<div class="section-hdr">Supplies Distributed</div>
<div class="label">Syringes — Longs</div>
<div class="chips" data-group="longs" data-mode="single">
<button class="chip">0</button><button class="chip">10</button><button class="chip">20</button><button class="chip">30</button><button class="chip">40</button><button class="chip">50</button>
</div>
<div class="label" style="margin-top:10px">Syringes — Shorts</div>
<div class="chips" data-group="shorts" data-mode="single">
<button class="chip">0</button><button class="chip">10</button><button class="chip">20</button><button class="chip">30</button><button class="chip">40</button><button class="chip">50</button>
</div>
<div class="label" style="margin-top:10px">Fentanyl Test Strips</div>
<div class="chips" data-group="fts" data-mode="single">
<button class="chip">0</button><button class="chip">5</button><button class="chip">10</button><button class="chip">20</button><button class="chip">50</button>
</div>
<div class="label" style="margin-top:10px">Alt Supplies (select all)</div>
<div class="chips" data-group="alt" data-mode="multi">
<button class="chip">Condoms</button><button class="chip">Pipes</button><button class="chip">Tourniquets</button><button class="chip">Cookers</button><button class="chip">Cottons/filters</button><button class="chip">Alcohol pads</button><button class="chip">Sharps container</button><button class="chip">Wound care kit</button>
</div>
</div>

<div class="card">
<div class="section-hdr">Naloxone</div>
<div class="label">Naloxone IM (kits)</div>
<div class="chips" data-group="nalox-im" data-mode="single">
<button class="chip">0</button><button class="chip">1</button><button class="chip">2</button><button class="chip">3</button><button class="chip">4</button><button class="chip">5</button>
</div>
<div class="label" style="margin-top:10px">Naloxone Nasal (kits)</div>
<div class="chips" data-group="nalox-nasal" data-mode="single">
<button class="chip">0</button><button class="chip">1</button><button class="chip">2</button><button class="chip">3</button><button class="chip">4</button><button class="chip">5</button>
</div>
<div class="label" style="margin-top:10px">Sec Distrib Kits</div>
<div class="chips" data-group="sec" data-mode="single">
<button class="chip">0</button><button class="chip">1</button><button class="chip">2</button><button class="chip">3</button><button class="chip">4</button><button class="chip">5</button>
</div>
</div>

<div class="card">
<div class="section-hdr">Naloxone Training</div>
<div class="chips" data-group="training" data-mode="single">
<button class="chip sage">Trained by us (today)</button><button class="chip sage">Previously trained by AP</button><button class="chip sage">Trained elsewhere</button><button class="chip sage">No training</button>
</div>
</div>

<div class="card">
<div class="section-hdr">Recovery Support Services (Annex D)</div>
<div class="label">Peer Support</div>
<div class="chips" data-group="svc" data-mode="multi">
<button class="chip sage">Peer check-in</button><button class="chip sage">Safer use education</button><button class="chip sage">Emotional support</button><button class="chip sage">Resource navigation</button>
</div>
<div class="label" style="margin-top:10px">Referrals &amp; Services</div>
<div class="chips" data-group="svc" data-mode="multi">
<button class="chip sage">MAT/MOUD referral</button><button class="chip sage">Mental health referral</button><button class="chip sage">Medical referral</button><button class="chip sage">Wound care</button><button class="chip sage">Housing support</button><button class="chip sage">Transportation support</button><button class="chip sage">Employment services</button><button class="chip sage">Vocational/GED referral</button><button class="chip sage">Family supports</button><button class="chip sage">Benefits/ID assistance</button><button class="chip sage">Legal aid referral</button><button class="chip sage">Secondary distribution</button>
</div>
</div>

<div class="card">
<div class="reversal-wrap">
<div class="toggle-row"><span>Reported Reversal?</span><input type="checkbox" id="reversal-toggle" onchange="toggleReversal()"></div>
</div>
<div id="reversal-details" class="hidden" style="margin-top:10px">
<div class="label">Reporter Type</div>
<div class="chips" data-group="reporter" data-mode="single">
<button class="chip danger">SSP Participant</button><button class="chip danger">OEND Participant</button><button class="chip danger">Community Member</button><button class="chip danger">Sec Distro Recipient</button><button class="chip danger">Staff/Volunteer</button>
</div>
<div class="label" style="margin-top:10px">OD Outcome</div>
<div class="chips" data-group="od-outcome" data-mode="single">
<button class="chip danger">Alive and well</button><button class="chip danger">Alive - hospital</button><button class="chip danger">Alive - unknown condition</button><button class="chip danger">Deceased</button><button class="chip danger">Unknown</button>
</div>
<div class="row2" style="margin-top:8px">
<div><div class="label">Nasal doses used</div><div class="chips" data-group="od-nasal" data-mode="single"><button class="chip danger">0</button><button class="chip danger">1</button><button class="chip danger">2</button><button class="chip danger">3</button><button class="chip danger">4</button></div></div>
<div><div class="label">IM doses used</div><div class="chips" data-group="od-inj" data-mode="single"><button class="chip danger">0</button><button class="chip danger">1</button><button class="chip danger">2</button><button class="chip danger">3</button><button class="chip danger">4</button></div></div>
</div>
<div class="label" style="margin-top:10px">OD Demographics (de-identified)</div>
<div class="chips" data-group="od-gender" data-mode="single">
<button class="chip danger">Woman</button><button class="chip danger">Man</button><button class="chip danger">Non-binary</button><button class="chip danger">Unknown</button>
</div>
<div class="field" style="margin-top:6px"><label>Race/Ethnicity</label></div>
<div class="chips" data-group="od-race" data-mode="multi">
<button class="chip danger">White</button><button class="chip danger">Black</button><button class="chip danger">Hispanic/Latino</button><button class="chip danger">Native American</button><button class="chip danger">Other</button><button class="chip danger">Unknown</button>
</div>
<div class="row2" style="margin-top:8px">
<div class="field"><label>Age Range</label><select id="od-age"><option value="">Select</option><option>Under 18</option><option>18-24</option><option>25-34</option><option>35-44</option><option>45-54</option><option>55-64</option><option>65+</option><option>Unknown</option></select></div>
<div class="field"><label>County</label><select id="od-county"><option value="">Select</option><option>Clarke</option><option>Oconee</option><option>Jackson</option><option>Madison</option><option>Barrow</option><option>Oglethorpe</option><option>Other</option><option>Unknown</option></select></div>
</div>
</div>
</div>

<div class="card">
<div class="field"><label>Notes</label><textarea id="v-notes" placeholder="Anything notable about this visit..."></textarea></div>
</div>

<button id="v-submit" class="btn btn-sage" onclick="submitVisit()">Submit Visit</button>
<div id="v-err" class="err">Participant ID and date are required.</div>
<div id="v-success" class="hidden">
<div class="success-box"><h3>Visit Logged</h3><p>Data saved to SSP Visits</p></div>
<button class="btn btn-outline" onclick="resetVisit()">Log another visit</button>
</div>
</div>

<!-- ════════════════ EVENTS SCREEN ════════════════ -->
<div id="screen-events" class="screen">
<div id="event-setup">
<div class="card">
<div class="section-hdr teal-hdr">Event / Training Details</div>
<div class="field"><label>Event Title</label><input id="e-title" placeholder="e.g. OEND Training — Clarke Co Library"></div>
<div class="field"><label>Date</label><input id="e-date" type="date"></div>
<div class="label">Event Type</div>
<div class="chips" data-group="etype" data-mode="single">
<button class="chip teal">OEND Training</button><button class="chip teal">Stigma Reduction</button><button class="chip teal">Recovery Support Group</button><button class="chip teal">Tabling/Outreach</button><button class="chip teal">Speaking/Presentation</button><button class="chip teal">Provider Training</button><button class="chip teal">Community Collaboration</button>
</div>
<div class="row2" style="margin-top:10px">
<div class="field"><label>Trainer / Facilitator</label>
<div class="chips" data-group="e-trainer" data-mode="single">
<button class="chip teal">OK</button><button class="chip teal">RK</button><button class="chip teal">Other</button>
</div>
<input id="e-trainer-other" class="hidden" placeholder="Name" style="margin-top:6px">
</div>
<div class="field"><label>Duration</label>
<div class="chips" data-group="e-duration" data-mode="single">
<button class="chip teal">30 min</button><button class="chip teal">1 hr</button><button class="chip teal">2 hr</button><button class="chip teal">Half day</button><button class="chip teal">Full day</button>
</div>
</div>
</div>
<div class="label" style="margin-top:10px">Format</div>
<div class="chips" data-group="e-format" data-mode="single">
<button class="chip teal">In-person</button><button class="chip teal">Virtual</button><button class="chip teal">Hybrid</button>
</div>
<div class="field" style="margin-top:10px"><label>Location / Venue</label><input id="e-location" placeholder="e.g. Clarke Co Library, Zoom, etc."></div>
<div class="field"><label>Partner / Collaborating Org</label><input id="e-partner" placeholder="e.g. UGA School of Social Work"></div>
<div class="field"><label>Funder / Grant</label>
<div class="chips" data-group="e-funder" data-mode="single">
<button class="chip teal">SOR/DBHDD</button><button class="chip teal">Other grant</button><button class="chip teal">Unfunded</button>
</div>
</div>
<div class="field"><label>Notes / Description</label><textarea id="e-notes" placeholder="Topic, curriculum used, audience, visibility notes for DBHDD..."></textarea></div>
</div>
<button class="btn btn-teal" onclick="startEvent()"">Start Event → Add Attendees</button>
<div id="e-err" class="err">Title, date, and event type are required.</div>
</div>

<div id="event-attendees" class="hidden">
<div class="card" style="background:#e8f4f4;border-color:#1B6B6B">
<div style="font-size:14px;font-weight:700;color:#1B6B6B" id="ea-event-title"></div>
<div style="font-size:12px;color:#6B5B4E;margin-top:2px" id="ea-event-meta"></div>
</div>
<div id="ea-count" class="attendee-count">0 attendees logged</div>

<div class="card">
<div class="section-hdr teal-hdr">Add Attendee</div>
<div class="row2">
<div class="field"><label>Initials</label><input id="ea-initials" maxlength="4" autocapitalize="characters" placeholder="AB"></div>
<div class="field"><label>Age Range</label><select id="ea-age"><option value="">Select</option><option>Under 18</option><option>18-24</option><option>25-34</option><option>35-44</option><option>45-54</option><option>55-64</option><option>65+</option></select></div>
</div>
<div class="label">Race / Ethnicity</div>
<div class="chips" data-group="ea-race" data-mode="multi">
<button class="chip teal">White</button><button class="chip teal">Black</button><button class="chip teal">Hispanic/Latino</button><button class="chip teal">Native American</button><button class="chip teal">Asian</button><button class="chip teal">Multiracial</button><button class="chip teal">Other</button>
</div>
<div class="row2" style="margin-top:8px">
<div class="field"><label>ZIP</label><input id="ea-zip" inputmode="numeric" maxlength="5" placeholder="30601"></div>
<div class="field"><label>County</label><select id="ea-county"><option value="">Select</option><option>Clarke</option><option>Oconee</option><option>Jackson</option><option>Madison</option><option>Barrow</option><option>Oglethorpe</option><option>Other</option></select></div>
</div>
<div class="label">Relationship to Substance Use</div>
<div class="chips" data-group="ea-rel" data-mode="single">
<button class="chip teal">Person who uses</button><button class="chip teal">Family/friend</button><button class="chip teal">Provider</button><button class="chip teal">First responder</button><button class="chip teal">Community member</button><button class="chip teal">Student</button><button class="chip teal">Other</button>
</div>
<div class="label" style="margin-top:10px">Naloxone Given</div>
<div class="row2">
<div><div class="label">IM kits</div><div class="chips" data-group="ea-nalox-im" data-mode="single"><button class="chip teal">0</button><button class="chip teal">1</button><button class="chip teal">2</button></div></div>
<div><div class="label">Nasal kits</div><div class="chips" data-group="ea-nalox-nasal" data-mode="single"><button class="chip teal">0</button><button class="chip teal">1</button><button class="chip teal">2</button></div></div>
</div>
<div class="label" style="margin-top:10px">Sec Distrib Kits</div>
<div class="chips" data-group="ea-sec" data-mode="single">
<button class="chip teal">0</button><button class="chip teal">1</button><button class="chip teal">2</button><button class="chip teal">3</button>
</div>
<div class="label" style="margin-top:10px">Existing SSP Participant?</div>
<div class="row2">
<div class="field"><label>Participant ID (if known)</label><input id="ea-pid" inputmode="numeric" placeholder="Leave blank if N/A"></div>
<div class="field"><label>Completion</label><select id="ea-completion"><option>Completed</option><option>Partial</option><option>No-show</option></select></div>
</div>
</div>
<button class="btn btn-teal" onclick="addAttendee(this)">+ Add This Attendee</button>
<div id="ea-err" class="err">Initials required.</div>

<div id="ea-logged-list" style="margin-top:12px"></div>

<button class="btn btn-outline-teal" onclick="finishEvent()" style="margin-top:12px">Finish Event</button>
</div>

<div id="event-done" class="hidden">
<div class="success-box"><h3>Event Saved</h3><p id="event-done-msg"></p></div>
<button class="btn btn-outline-teal" onclick="resetEvent()">Log Another Event</button>
</div>
</div>

<script>
const WEB_APP_URL = 'https://script.google.com/macros/s/AKfycbzCYLYOWFZXG4KCWcf-nFAAvYzaBFNaiJ7aB3oE5-mzqyIZrS0cDIznBxTNbqxd1U-p/exec';

// ── State ──
let registry = [];
const sel = {};
let currentEventId = null;
let attendeeCount = 0;

// Load existing participants on page load (IDs + initials + birth year)
fetch(WEB_APP_URL)
  .then(r => r.json())
  .then(d => {
    if (d.participants) {
      registry = d.participants.map(p => ({ id: Number(p.id), initials: (p.initials || '').toUpperCase(), year: String(p.year || '') }));
    } else if (d.ids) {
      registry = d.ids.map(id => ({ id: Number(id) }));
    }
  })
  .catch(() => {});

// ── Navigation ──
function showScreen(name) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById('screen-' + name).classList.add('active');
  document.querySelectorAll('.nav-btn').forEach((b, i) => {
    b.classList.toggle('active', b.textContent.toLowerCase().includes(name === 'intake' ? 'intake' : name === 'lookup' ? 'lookup' : name === 'visit' ? 'visit' : 'event'));
  });
}

// ── Chip logic ──
document.addEventListener('click', function(e) {
  if (!e.target.classList.contains('chip')) return;
  const wrap = e.target.closest('[data-group]');
  if (!wrap) return;
  const group = wrap.dataset.group;
  const mode = wrap.dataset.mode;
  if (mode === 'single') {
    wrap.querySelectorAll('.chip').forEach(c => c.classList.remove('on'));
    e.target.classList.add('on');
    sel[group] = e.target.dataset.val || e.target.textContent;
  } else {
    e.target.classList.toggle('on');
  }
  if (group === 'worker') {
    document.getElementById('v-worker-other').classList.toggle('hidden', sel['worker'] !== 'Other');
  }
  if (group === 'loc') {
    document.getElementById('v-loc-other').classList.toggle('hidden', sel['loc'] !== 'Other');
  }
  if (group === 'e-trainer') {
    document.getElementById('e-trainer-other').classList.toggle('hidden', sel['e-trainer'] !== 'Other');
  }
});

function getToggled(group) {
  const chips = document.querySelectorAll('[data-group="' + group + '"] .chip.on');
  return Array.from(chips).map(c => c.dataset.val || c.textContent).join('; ');
}

// ── Reversal toggle ──
function toggleReversal() {
  document.getElementById('reversal-details').classList.toggle('hidden', !document.getElementById('reversal-toggle').checked);
}

// ════════════════ INTAKE ════════════════
async function submitIntake(btn) {
  const initials = document.getElementById('i-initials').value.trim().toUpperCase();
  const year = document.getElementById('i-year').value.trim();
  const gender = sel['gender'] || document.getElementById('i-gender-other').value.trim();
  const errEl = document.getElementById('intake-err');
  if (!initials || !year || !gender) { errEl.style.display = 'block'; return; }
  errEl.style.display = 'none';

  const dup = registry.find(p => p.initials === initials && p.year === year);
  let id;
  if (dup) { id = dup.id; }
  else {
    const existing = registry.map(p => p.id);
    do { id = Math.floor(Math.random() * 9000) + 1000; } while (existing.includes(id));
    registry.push({ id, initials, year });
  }

  btn.innerHTML = '<span class="spinner"></span> Registering...';
  btn.disabled = true;

  try {
    await fetch(WEB_APP_URL, {
      method: 'POST',
      body: JSON.stringify({
        action: 'registerParticipant',
        id, initials, birthYear: year, gender,
        race: getToggled('race'),
        housing: sel['housing'] || '',
        participantType: sel['ptype'] || 'SSP',
        zip: document.getElementById('i-zip').value.trim(),
        county: document.getElementById('i-county').value,
      })
    });
  } catch(e) {}

  document.getElementById('result-id').textContent = id;
  document.getElementById('intake-form').classList.add('hidden');
  document.getElementById('intake-result').classList.remove('hidden');
  btn.innerHTML = 'Generate anonymous ID';
  btn.disabled = false;
}

function resetIntake() {
  document.getElementById('intake-form').classList.remove('hidden');
  document.getElementById('intake-result').classList.add('hidden');
  ['i-initials','i-year','i-zip','i-gender-other'].forEach(id => document.getElementById(id).value = '');
  document.getElementById('i-county').selectedIndex = 0;
  document.querySelectorAll('#screen-intake .chip').forEach(c => c.classList.remove('on'));
  ['gender','race','housing','ptype'].forEach(k => delete sel[k]);
}

function goVisit() {
  const id = document.getElementById('result-id').textContent;
  document.getElementById('v-id').value = id;
  showScreen('visit');
}

// ════════════════ LOOKUP ════════════════
function lookupId() {
  const initials = document.getElementById('l-initials').value.trim().toUpperCase();
  const year = document.getElementById('l-year').value.trim();
  const match = registry.find(p => p.initials === initials && p.year === year);
  document.getElementById('lookup-result').classList.add('hidden');
  document.getElementById('lookup-none').classList.add('hidden');
  if (match) {
    document.getElementById('lookup-id').textContent = match.id;
    document.getElementById('lookup-result').classList.remove('hidden');
  } else {
    document.getElementById('lookup-none').classList.remove('hidden');
  }
}

function goVisitFromLookup() {
  const id = document.getElementById('lookup-id').textContent;
  document.getElementById('v-id').value = id;
  showScreen('visit');
}

// ════════════════ VISIT LOG ════════════════
async function submitVisit() {
  const id = document.getElementById('v-id').value;
  const date = document.getElementById('v-date').value;
  const errEl = document.getElementById('v-err');
  if (!id || !date) { errEl.style.display = 'block'; return; }
  errEl.style.display = 'none';

  const btn = document.getElementById('v-submit');
  btn.innerHTML = '<span class="spinner"></span> Submitting...';
  btn.disabled = true;

  const reversal = document.getElementById('reversal-toggle').checked;
  const worker = sel['worker'] === 'Other' ? document.getElementById('v-worker-other').value.trim().toUpperCase() : (sel['worker'] || '');

  try {
    await fetch(WEB_APP_URL, {
      method: 'POST',
      body: JSON.stringify({
        action: 'logVisit',
        participantId: id,
        date,
        worker: worker,
        location: sel['loc'] === 'Other' ? document.getElementById('v-loc-other').value.trim() : (sel['loc'] || ''),
        newOrReturning: sel['nr'] || '',
        housing: sel['v-housing'] || '',
        substances: getToggled('subst'),
        route: getToggled('route'),
        longs: sel['longs'] || '0',
        shorts: sel['shorts'] || '0',
        fts: sel['fts'] || '0',
        altSupplies: getToggled('alt'),
        naloxIM: sel['nalox-im'] || '0',
        naloxNasal: sel['nalox-nasal'] || '0',
        secDistrib: sel['sec'] || '0',
        training: sel['training'] || '',
        reversal: reversal ? 'Yes' : 'No',
        reporterType: reversal ? (sel['reporter'] || '') : '',
        odOutcome: reversal ? (sel['od-outcome'] || '') : '',
        odNasalDoses: reversal ? (sel['od-nasal'] || '') : '',
        odInjDoses: reversal ? (sel['od-inj'] || '') : '',
        odGender: reversal ? (sel['od-gender'] || '') : '',
        odRace: reversal ? getToggled('od-race') : '',
        odAge: reversal ? document.getElementById('od-age').value : '',
        odCounty: reversal ? document.getElementById('od-county').value : '',
        services: getToggled('svc'),
        notes: document.getElementById('v-notes').value.trim(),
      })
    });
  } catch(e) {}

  btn.classList.add('hidden');
  document.getElementById('v-success').classList.remove('hidden');
}

function resetVisit() {
  const btn = document.getElementById('v-submit');
  btn.innerHTML = 'Submit Visit';
  btn.disabled = false;
  btn.classList.remove('hidden');
  document.getElementById('v-success').classList.add('hidden');
  document.getElementById('v-err').style.display = 'none';
  ['v-id','v-notes'].forEach(id => document.getElementById(id).value = '');
  document.getElementById('v-date').value = '';
  document.getElementById('v-worker-other').value = '';
  document.getElementById('v-worker-other').classList.add('hidden');
  document.getElementById('v-loc-other').value = '';
  document.getElementById('v-loc-other').classList.add('hidden');
  document.getElementById('reversal-toggle').checked = false;
  document.getElementById('reversal-details').classList.add('hidden');
  document.getElementById('od-age').selectedIndex = 0;
  document.getElementById('od-county').selectedIndex = 0;
  document.querySelectorAll('#screen-visit .chip').forEach(c => c.classList.remove('on'));
  ['worker','nr','loc','v-housing','subst','route','longs','shorts','fts','alt','nalox-im','nalox-nasal','sec','training','svc','reporter','od-outcome','od-nasal','od-inj','od-gender','od-race'].forEach(k => delete sel[k]);
}

// ════════════════ EVENTS ════════════════
async function startEvent() {
  const title = document.getElementById('e-title').value.trim();
  const date = document.getElementById('e-date').value;
  const etype = sel['etype'] || '';
  const errEl = document.getElementById('e-err');
  if (!title || !date || !etype) { errEl.style.display = 'block'; return; }
  errEl.style.display = 'none';

  currentEventId = 'EVT-' + Date.now();
  attendeeCount = 0;

  const trainer = sel['e-trainer'] === 'Other' ? document.getElementById('e-trainer-other').value.trim() : (sel['e-trainer'] || '');

  try {
    await fetch(WEB_APP_URL, {
      method: 'POST',
      body: JSON.stringify({
        action: 'createEvent',
        eventId: currentEventId,
        title, date, eventType: etype,
        trainer: trainer,
        duration: sel['e-duration'] || '',
        format: sel['e-format'] || '',
        location: document.getElementById('e-location').value.trim(),
        partner: document.getElementById('e-partner').value.trim(),
        funder: sel['e-funder'] || '',
        notes: document.getElementById('e-notes').value.trim(),
      })
    });
  } catch(e) {}

  document.getElementById('ea-event-title').textContent = title;
  document.getElementById('ea-event-meta').textContent = date + ' · ' + etype + (trainer ? ' · ' + trainer : '');
  document.getElementById('event-setup').classList.add('hidden');
  document.getElementById('event-attendees').classList.remove('hidden');
}

async function addAttendee(btn) {
  const initials = document.getElementById('ea-initials').value.trim().toUpperCase();
  const errEl = document.getElementById('ea-err');
  if (!initials) { errEl.style.display = 'block'; return; }
  errEl.style.display = 'none';

  btn.innerHTML = '<span class="spinner"></span> Adding...';
  btn.disabled = true;

  try {
    await fetch(WEB_APP_URL, {
      method: 'POST',
      body: JSON.stringify({
        action: 'logAttendee',
        eventId: currentEventId,
        initials: initials,
        ageRange: document.getElementById('ea-age').value,
        race: getToggled('ea-race'),
        zip: document.getElementById('ea-zip').value.trim(),
        county: document.getElementById('ea-county').value,
        relationship: sel['ea-rel'] || '',
        naloxIM: sel['ea-nalox-im'] || '0',
        naloxNasal: sel['ea-nalox-nasal'] || '0',
        secDistrib: sel['ea-sec'] || '0',
        participantId: document.getElementById('ea-pid').value.trim(),
        completion: document.getElementById('ea-completion').value,
      })
    });
  } catch(e) {}

  attendeeCount++;
  document.getElementById('ea-count').textContent = attendeeCount + ' attendee' + (attendeeCount !== 1 ? 's' : '') + ' logged';

  const list = document.getElementById('ea-logged-list');
  const div = document.createElement('div');
  div.className = 'attendee-row';
  div.innerHTML = '<span class="row-num">#' + attendeeCount + '</span> ' + initials + (document.getElementById('ea-pid').value ? ' (ID: ' + document.getElementById('ea-pid').value + ')' : '');
  list.appendChild(div);

  ['ea-initials','ea-zip','ea-pid'].forEach(id => document.getElementById(id).value = '');
  document.getElementById('ea-age').selectedIndex = 0;
  document.getElementById('ea-county').selectedIndex = 0;
  document.getElementById('ea-completion').selectedIndex = 0;
  document.querySelectorAll('#event-attendees [data-group^="ea-"] .chip').forEach(c => c.classList.remove('on'));
  ['ea-race','ea-rel','ea-nalox-im','ea-nalox-nasal','ea-sec'].forEach(k => delete sel[k]);

  btn.innerHTML = '+ Add This Attendee';
  btn.disabled = false;
  document.getElementById('ea-initials').focus();
}

function finishEvent() {
  document.getElementById('event-attendees').classList.add('hidden');
  document.getElementById('event-done').classList.remove('hidden');
  document.getElementById('event-done-msg').textContent = attendeeCount + ' attendee' + (attendeeCount !== 1 ? 's' : '') + ' logged for this event.';
}

function resetEvent() {
  document.getElementById('event-setup').classList.remove('hidden');
  document.getElementById('event-done').classList.add('hidden');
  document.getElementById('ea-logged-list').innerHTML = '';
  ['e-title','e-location','e-partner','e-notes','e-trainer-other'].forEach(id => document.getElementById(id).value = '');
  document.getElementById('e-date').value = '';
  document.querySelectorAll('#screen-events .chip').forEach(c => c.classList.remove('on'));
  ['etype','e-trainer','e-duration','e-format','e-funder'].forEach(k => delete sel[k]);
  document.getElementById('e-trainer-other').classList.add('hidden');
  currentEventId = null;
  attendeeCount = 0;
}

// Set today's date as default
document.addEventListener('DOMContentLoaded', function() {
  var today = new Date().toISOString().split('T')[0];
  document.getElementById('v-date').value = today;
  document.getElementById('e-date').value = today;
});
</script>
</body>
</html>
